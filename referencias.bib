  volume       = {126},
  number       = {190},
  month        = {4 out.},
  year         = {1988},
  section      = {Seção 1, parte 1},
  pages        = {19291-19292}
}

% LEGISLAÇÃO CONSULTADA EM PORTAL OFICIAL: LEI ONLINE.
% Informe jurisdição, epígrafe, ementa e dados da publicação.
% misc é a implementação atual deste exemplo, não a categoria normativa.
% Substitua a página inicial do portal pela URL específica da lei em trabalhos reais.
% ATENÇÃO: subtitle é usado aqui para a ementa; a redação/capitalização e a separação
% por ponto devem ser conferidas, pois o estilo o trata como subtítulo após dois-pontos.
% Não troque automaticamente para legislation: sua função atual foi feita para
% publicação em periódico oficial e ainda não imprime publisher.
@misc{brasil2024,
  organization  = {Brasil},
  title         = {Lei nº 14.874, de 28 de maio de 2024},
