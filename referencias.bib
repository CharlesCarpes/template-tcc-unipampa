  address       = {Brasília, DF},
  year          = {2024},
  url           = {https://www.planalto.gov.br/},
  urlaccessdate = {10 jul. 2026}
}

% CAPÍTULO DE LIVRO COM AUTOR PRÓPRIO, EM OBRA ORGANIZADA/EDITADA.
% Use incollection: author/title identificam o capítulo; editor/booktitle, o livro.
% Informe as páginas do capítulo; booksubtitle contém o subtítulo do livro.
% Manual: 5.3 (p. 38). O exemplo do manual identifica Silveira como organizadora.
% ATENÇÃO: para indicar organizador(a), acrescente editortype = {org.}; no estilo
% atual, editor sem editortype é apresentado como (Ed.). Os dados foram preservados.
@incollection{cassol2003,
  author        = {Glória Barbosa Cassol},
  title         = {Assessoria no {Centro de Educação da UFSM}: uma atividade dispensável?},
  booktitle     = {Práticas, identidade e memória},
  booksubtitle = {30 anos de {Relações Públicas na UFSM}},
  editor        = {Ada Cristina Machado da Silveira},
  editortype = {Org.},
  address       = {Santa Maria},
  publisher     = {FACOS-UFSM},
  year          = {2003},
  pages         = {183--190}
}

