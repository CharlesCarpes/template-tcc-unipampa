% SOFTWARE / PROGRAMA DE COMPUTADOR DISPONÍVEL ONLINE.
% Identifique responsável, título, versão, local se houver,
% data e descrição do recurso. A URL deve apontar à versão/release utilizada.
% As chaves duplas em author preservam a autoria coletiva como uma unidade.
% misc é a implementação atual; note contém versão e tipo do recurso.
% ATENÇÃO: a versão sai depois do ano no .bst atual; o manual a coloca após o título.
% Este exemplo representa software, não substitui automaticamente a referência
% à documentação, a uma base de dados ou a um artigo que descreva o software.
@misc{software2026,
  author        = {{Equipe do Projeto}},
  title         = {Nome do software},
  year          = {2026},
  note          = {Versão 1.0. Software},
  url           = {https://example.org/software},
  urlaccessdate = {10 jul. 2026}
}


