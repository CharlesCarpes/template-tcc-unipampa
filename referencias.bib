% LEGISLAÇÃO PUBLICADA NO DIÁRIO OFICIAL: DECRETO-LEI.
% Use para um ato legal cujo veículo de publicação seja o Diário Oficial.
% legislation é uma extensão do nosso .bst; não é um tipo padrão do BibTeX.
% Informe journal, data de publicação, seção/parte e páginas quando existentes.

@legislation{brasil1988,
  organization = {Brasil},
  title        = {Decreto-lei nº 2.481, de 3 de outubro de 1988},
